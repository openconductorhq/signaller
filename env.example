# Copy to ~/.config/signaller/env and chmod 600.
SIGNALLER_LISTEN=127.0.0.1:8787
SIGNALLER_ANTHROPIC_URL=https://api.anthropic.com
VALAR_URL=https://api.valarhq.ai
# Valar URL and key: read once, on the first start. After that, manage keys in the console.
VALAR_API_KEY=
# Model names live on the console page (Tracks panel), not here.
# Where console.json and stats.db live (default ~/.config/signaller; a leading ~ is expanded).
# SIGNALLER_CONFIG_DIR=~/.config/signaller
# Where stats.db lives (default: the config dir). The container uses the "stats" volume (/data): SQLite is
# not safe on a folder shared from the host, so don't point this at a bind mount.
# SIGNALLER_STATS_DIR=
# The settings lines' `hour` field and the console clock read the router's local time. In the
# container set TZ to an IANA zone (e.g. TZ=Asia/Jerusalem): the host's /etc/localtime isn't
# shared into the VM under Colima, and an unset or empty TZ means UTC. Outside a container the
# host's zone applies, so leave it unset there.
# TZ=
