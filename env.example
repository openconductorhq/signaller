# Copy to ~/.config/claude-router/env and chmod 600.
CLAUDE_ROUTER_LISTEN=127.0.0.1:8787
CLAUDE_ROUTER_ANTHROPIC_URL=https://api.anthropic.com
VALAR_URL=https://api.valarhq.ai
# Valar API key. Optional: without it, the Valar track answers 502.
VALAR_API_KEY=
LITELLM_URL=http://127.0.0.1:4000
# Optional. LiteLLM master key (or a virtual key, starts with sk-). Without it, the local track answers 502.
LITELLM_API_KEY=
# Model names live on the console page (Tracks panel), not here.
# Where console.json and stats.db live (default ~/.config/claude-router; a leading ~ is expanded).
# CLAUDE_ROUTER_CONFIG_DIR=~/.config/claude-router
