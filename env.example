# Copy to ~/.config/claude-router/env and chmod 600.
CLAUDE_ROUTER_LISTEN=127.0.0.1:8787
CLAUDE_ROUTER_ANTHROPIC_URL=https://api.anthropic.com
LITELLM_URL=http://127.0.0.1:4000
# Required. LiteLLM master key (or a virtual key, starts with sk-).
LITELLM_API_KEY=
# Must name LiteLLM model groups that exist (check GET /v1/models).
CLAUDE_ROUTER_LOCAL_SONNET=claude-sonnet-4-6
CLAUDE_ROUTER_LOCAL_HAIKU=claude-haiku-4-5-20251001
# Where console.json and stats.db live (default ~/.config/claude-router).
# CLAUDE_ROUTER_CONFIG_DIR=~/.config/claude-router
