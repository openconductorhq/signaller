FROM python:3.14-slim
WORKDIR /app
COPY *.py ./
COPY ui ui
USER 1000:1000
ENV PYTHONUNBUFFERED=1 \
    CLAUDE_ROUTER_IN_CONTAINER=1 \
    CLAUDE_ROUTER_LISTEN=0.0.0.0:8787 \
    CLAUDE_ROUTER_CONFIG_DIR=/config \
    CLAUDE_CONFIG_DIR=/claude
EXPOSE 8787
CMD ["python3", "-E", "-s", "claude_router.py"]
