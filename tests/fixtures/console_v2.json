{
  "version": 2,
  "lever": "rules",
  "otherwise": "anthropic",
  "rules": [
    {
      "name": "Tools only Anthropic can run",
      "kind": "dsl",
      "enabled": true,
      "text": "when servertool go anthropic",
      "builtin": "servertool"
    },
    {
      "name": "Tags in your message",
      "kind": "dsl",
      "enabled": true,
      "text": "when tag is planning go anthropic\nwhen tag is local go local\nwhen tag is execution go valar",
      "builtin": "tags"
    },
    {
      "name": "What the prompt is about",
      "kind": "classifier",
      "enabled": false,
      "text": "",
      "builtin": "classifier"
    },
    {
      "name": "Model the request asked for",
      "kind": "dsl",
      "enabled": true,
      "text": "when subagent and tier is fable go anthropic\nwhen subagent go valar\nwhen tier is opus or tier is fable go anthropic\nwhen tier is sonnet or tier is haiku or tier is other go valar",
      "builtin": "tier"
    }
  ],
  "classifier": {
    "model": "deepseek-ai/DeepSeek-V4.1-Flash",
    "threshold": 0.95,
    "timeout_s": 2.5,
    "upstream": "valar",
    "labels": [
      {
        "name": "planning",
        "description": "designing, specifying or planning work",
        "track": "anthropic"
      },
      {
        "name": "design & review",
        "description": "judging, reviewing or critiquing code or ideas",
        "track": "anthropic"
      },
      {
        "name": "coding",
        "description": "writing, editing, fixing or running code",
        "track": "valar"
      },
      {
        "name": "chit-chat",
        "description": "greetings, thanks, small talk",
        "track": "valar"
      }
    ]
  },
  "doubling": {
    "rate": 0,
    "tag": "",
    "shadow": {
      "anthropic": "valar",
      "valar": "anthropic",
      "local": null
    }
  },
  "models": {
    "valar": {
      "fable": "moonshotai/Kimi-K3",
      "opus": "zai-org/GLM-5.3",
      "sonnet": "zai-org/GLM-5.3-Flash",
      "haiku": "deepseek-ai/DeepSeek-V4.1-Flash-1017"
    },
    "local": {
      "fable": "claude-sonnet-4-6",
      "opus": "claude-sonnet-4-6",
      "sonnet": "claude-sonnet-4-6",
      "haiku": "claude-haiku-4-5-20251001"
    }
  },
  "windows": {
    "valar": {
      "fable": "asap",
      "opus": "asap",
      "sonnet": "asap",
      "haiku": "asap"
    }
  }
}